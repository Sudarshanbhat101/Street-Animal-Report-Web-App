<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Street Animal Reporting</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-2xl font-bold text-blue-600">Street Animal Help</a>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/report" class="text-gray-700 hover:text-blue-600">Report an Animal</a>
                    <a href="/admin" class="text-gray-700 hover:text-blue-600">Admin Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="bg-blue-600 text-white py-20">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h1 class="text-4xl font-bold mb-4">Help Street Animals in Need</h1>
            <p class="text-xl mb-8">Report injured or distressed animals to get them the help they deserve</p>
            <a href="/report" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 transition duration-300">
                Report an Animal
            </a>
        </div>
    </div>

    <!-- Animals Section -->
    <div class="max-w-7xl mx-auto px-4 py-16">
        <h2 class="text-3xl font-bold text-center mb-12">Reported Animals</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Dog Card -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="aspect-w-16 aspect-h-9">
                    <img src="https://media.istockphoto.com/id/955851492/photo/a-cute-brown-dog-is-posing-in-front-of-the-camera-in-one-of-the-many-colorful-alley-of.jpg?s=612x612&w=0&k=20&c=MWl-ERJkNMFR9wPuhdwpiIWsBsjRMhC-kADJgnl7a90=" 
                         alt="Dog" 
                         class="w-full h-64 object-cover">
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-semibold mb-2">Dogs</h3>
                    <p class="text-gray-600">Help us protect and care for street dogs in need of medical attention and shelter.</p>
                </div>
            </div>

            <!-- Cow Card -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="aspect-w-16 aspect-h-9">
                    <img src="https://i.natgeofe.com/n/dae9d878-be8b-45c1-87c3-e97f08efe9dc/NationalGeographic_689984s_3x2.jpg" 
                         alt="Cow" 
                         class="w-full h-64 object-cover">
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-semibold mb-2">Cows</h3>
                    <p class="text-gray-600">Support our efforts to help injured or abandoned cows find proper care and shelter.</p>
                </div>
            </div>

            <!-- Donkey Card -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="aspect-w-16 aspect-h-9">
                    <img src="https://www.shutterstock.com/image-photo/pair-donkey-being-stroll-on-260nw-2347136755.jpg" 
                         alt="Donkey" 
                         class="w-full h-64 object-cover">
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-semibold mb-2">Donkeys</h3>
                    <p class="text-gray-600">Assist in providing care and protection for working donkeys that need medical attention.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quotes Section -->
    <div class="max-w-7xl mx-auto px-4 py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white p-8 rounded-lg shadow-lg">
                <p class="text-xl italic mb-4">"The greatness of a nation and its moral progress can be judged by the way its animals are treated."</p>
                <p class="text-gray-600">- Mahatma Gandhi</p>
            </div>
            <div class="bg-white p-8 rounded-lg shadow-lg">
                <p class="text-xl italic mb-4">"Until one has loved an animal, a part of one's soul remains unawakened."</p>
                <p class="text-gray-600">- Anatole France</p>
            </div>
        </div>
    </div>

    <!-- How We Work Section -->
    <div class="bg-gray-100 py-16">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12">How We Work</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="text-center">
                    <div class="bg-blue-600 text-white w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">1</div>
                    <h3 class="text-xl font-semibold mb-2">Report an Animal</h3>
                    <p class="text-gray-600">Fill out our simple form with details about the animal's location and condition.</p>
                </div>
                <div class="text-center">
                    <div class="bg-blue-600 text-white w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">2</div>
                    <h3 class="text-xl font-semibold mb-2">We Review</h3>
                    <p class="text-gray-600">Our team quickly reviews your report and assesses the situation.</p>
                </div>
                <div class="text-center">
                    <div class="bg-blue-600 text-white w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">3</div>
                    <h3 class="text-xl font-semibold mb-2">Take Action</h3>
                    <p class="text-gray-600">We dispatch our team to provide immediate care and assistance.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="bg-blue-600 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold mb-4">Ready to Help?</h2>
            <p class="text-xl mb-8">Report an animal in need and make a difference in their life today.</p>
            <a href="/report" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 transition duration-300">
                Report an Animal
            </a>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-8">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p>&copy; 2024 Street Animal Help. All rights reserved.</p>
        </div>
    </footer>
</body>
</html> 