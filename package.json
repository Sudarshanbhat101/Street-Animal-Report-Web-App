{
  "name": "street-animal-guardian",
  "version": "1.0.0",
  "description": "Community web app for reporting and managing street animal rescue cases",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "build:css:once": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css"
  },
  "keywords": [
    "street-animals",
    "animal-rescue",
    "nodejs",
    "express",
    "mongodb",
    "ejs"
  ],
  "author": "Sudarshan Bhat (https://github.com/Sudarshanbhat101)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudarshanbhat101/Street-Animal-Report-Web-App.git"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "mongoose": "^8.1.1",
    "nodemailer": "^6.9.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "nodemon": "^3.0.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}
