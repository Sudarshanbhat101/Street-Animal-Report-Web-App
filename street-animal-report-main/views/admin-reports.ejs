<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Street Animal Reporting</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen">
    <nav class="bg-white shadow-md">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold text-primary-600">Street Animal Reporting</h1>
            <div class="space-x-4">
                <a href="/" class="btn-secondary">Submit Report</a>
                <a href="/view-reports" class="btn-secondary">View Reports</a>
            </div>
        </div>
    </nav>

    <main class="container mx-auto px-4 py-8">
        <div class="card animate-fade-in">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-3xl font-bold text-secondary-800">Admin Dashboard</h2>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-secondary-600">
                        Total Reports: <%= reports.length %>
                    </span>
                    <span class="text-sm text-secondary-600">
                        Resolved: <%= reports.filter(r => r.resolved).length %>
                    </span>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% reports.forEach(report => { %>
                    <div class="bg-white rounded-lg shadow-md overflow-hidden border border-secondary-200">
                        <% if (report.image) { %>
                            <div class="aspect-w-16 aspect-h-9">
                                <img src="<%= report.image %>" alt="Animal Image" class="object-cover w-full h-48">
                            </div>
                        <% } %>
                        
                        <div class="p-4">
                            <div class="flex items-center justify-between mb-2">
                                <span class="px-3 py-1 text-sm font-semibold rounded-full 
                                    <%= report.status === 'stray' ? 'bg-yellow-100 text-yellow-800' : 
                                        report.status === 'injured' ? 'bg-red-100 text-red-800' : 
                                        'bg-gray-100 text-gray-800' %>">
                                    <%= report.status.charAt(0).toUpperCase() + report.status.slice(1) %>
                                </span>
                                <span class="text-sm text-secondary-500">
                                    <%= new Date(report.reportedAt).toLocaleDateString() %>
                                </span>
                            </div>
                            
                            <h3 class="text-lg font-semibold text-secondary-800 mb-2">
                                <%= report.animalType %>
                            </h3>
                            
                            <p class="text-sm text-secondary-600 mb-4">
                                <%= report.readableLocation || 'Location not available' %>
                            </p>
                            
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-secondary-500">
                                    <%= report.resolved ? 'Resolved' : 'Pending' %>
                                </span>
                                <% if (!report.resolved) { %>
                                    <form action="/admin/resolve/<%= report._id %>" method="POST" class="inline">
                                        <button type="submit" class="btn-primary text-sm">
                                            Mark as Resolved
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
            
            <% if (reports.length === 0) { %>
                <div class="text-center py-12">
                    <svg class="w-16 h-16 mx-auto text-secondary-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <h3 class="text-xl font-semibold text-secondary-800 mb-2">No Reports Yet</h3>
                    <p class="text-secondary-600 mb-4">There are no reports to manage at the moment.</p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
